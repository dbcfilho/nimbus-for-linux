#!/bin/sh
# nimbus-profile [standard|game]: troca o perfil do gamepad virtual do Nimbus.
# Sem argumento, mostra o perfil atual. O daemon recarrega por SIGHUP, sem reconectar o controle.
conf="${XDG_CONFIG_HOME:-$HOME/.config}/nimbus-linux/profile"
case "$1" in
  "") cat "$conf" 2>/dev/null || echo standard; exit 0 ;;
  standard|game) ;;
  *) echo "uso: nimbus-profile [standard|game]" >&2; exit 2 ;;
esac
mkdir -p "$(dirname "$conf")"
echo "$1" > "$conf"
systemctl --user kill --signal=HUP nimbus-linux.service 2>/dev/null || true
